#!/usr/bin/env python3
import json
import subprocess
import time
import sys
import os
from datetime import datetime, timedelta, timezone

HYDRA = os.environ.get("HYDRA_BIN", "hydra")

# 2026-09-07: timed_out and abandoned map to unknown.
MAPPING = {
    "live": ("working", "live"),
    "abandoned": ("unknown", "abandoned"),
    "completed": ("idle", "completed"),
    "failed": ("idle", "failed"),
    "gated": ("blocked", "gated"),
    "auth_failed": ("blocked", "auth_failed"),
    "rate_limited": ("blocked", "rate_limited"),
    "mcp_unavailable": ("blocked", "mcp_unavailable"),
    "skill_collision": ("blocked", "skill_collision"),
    "crashed": ("unknown", "crashed"),
}


def is_alive(status_json):
    return status_json.get("state") == "live"


def alive_token(status_json):
    return "yes" if is_alive(status_json) else "no"


def timed_out_label(alive):
    if alive:
        return "timed out, child alive"
    return "timed out, child gone"


def get_herdr_state_and_label(status_json):
    state = status_json.get("state")
    if state == "live":
        return MAPPING["live"]
    if state == "abandoned":
        return MAPPING["abandoned"]
    if state == "ended":
        outcome = status_json.get("result", {}).get("outcome")
        if outcome == "timed_out":
            return ("unknown", timed_out_label(is_alive(status_json)))
        if outcome in MAPPING:
            return MAPPING[outcome]
        return ("unknown", outcome or "unknown")
    return ("unknown", "unknown")


def total_tokens(projection):
    if not projection:
        return None
    counts = projection.get("usage", {}).get("counts") or {}
    if not counts:
        return None
    if "total_tokens" in counts:
        return counts["total_tokens"]
    total = sum(
        value
        for key, value in counts.items()
        if key.endswith("_tokens") and isinstance(value, int)
    )
    return total or None


def parse_started_at(status_json):
    started = status_json.get("started_at")
    if not started:
        return None
    text = started.replace("Z", "+00:00")
    try:
        return datetime.fromisoformat(text)
    except ValueError:
        return None


def elapsed_seconds(status_json, now=None):
    started = parse_started_at(status_json)
    if started is None:
        return None
    if now is None:
        now = datetime.now(timezone.utc)
    if started.tzinfo is None:
        started = started.replace(tzinfo=timezone.utc)
    seconds = round((now - started).total_seconds())
    # Reported in steps of thirty seconds, so a live run does not send Herdr
    # a fresh report every poll for a number nobody reads to the second.
    return seconds - seconds % 30


def latest_tool_call(events_data):
    events = events_data.get("events") or []
    tool_calls = [event for event in events if event.get("type") == "tool_call"]
    if not tool_calls:
        return None, None
    latest = max(tool_calls, key=lambda event: event.get("seq", -1))
    return latest.get("name"), latest.get("seq")


def count_denials(events_data):
    events = events_data.get("events") or []
    return sum(
        1
        for event in events
        if event.get("type") == "permission_decision" and event.get("decision") == "deny"
    )


def parse_event_ts(ts):
    if not ts:
        return None
    text = ts.replace("Z", "+00:00")
    try:
        parsed = datetime.fromisoformat(text)
    except ValueError:
        return None
    if parsed.tzinfo is None:
        parsed = parsed.replace(tzinfo=timezone.utc)
    return parsed


# `hydra show --events` carries no timestamp on a normalized event (build ticket 122 found it),
# so a rate cannot be read off one poll. The bridge polls every two seconds; this keeps, per
# run, the tool-call total at each poll and reads the rate as the growth over the last 30 s.
TOOL_HISTORY = {}


def count_tool_rate(events_data, now=None, run_id=None, history=None):
    events = events_data.get("events") or []
    if now is None:
        now = datetime.now(timezone.utc)
    cutoff = now - timedelta(seconds=30)
    stamped = [e for e in events if e.get("type") == "tool_call" and parse_event_ts(e.get("ts"))]
    if stamped:
        return sum(1 for e in stamped if parse_event_ts(e.get("ts")) >= cutoff)
    total = sum(1 for e in events if e.get("type") == "tool_call")
    if run_id is None:
        return 0
    history = TOOL_HISTORY if history is None else history
    samples = history.setdefault(run_id, [])
    samples.append((now, total))
    del samples[:-40]
    older = [count for (at, count) in samples if at <= cutoff]
    baseline = older[-1] if older else samples[0][1]
    return max(0, total - baseline)


def short_run_id(run_id):
    if not run_id:
        return ""
    return run_id[:8]


def build_tokens(status_json, events_data=None, now=None):
    tokens = {
        "run_id": status_json.get("run_id") or "",
        "provider": status_json.get("provider") or "",
        "policy": status_json.get("policy") or "",
        "state": status_json.get("state") or "",
        "alive": alive_token(status_json),
    }

    result = status_json.get("result")
    if result:
        outcome = result.get("outcome")
        if outcome:
            tokens["outcome"] = outcome
        token_total = total_tokens(result)
        if token_total is not None:
            tokens["tokens"] = str(token_total)

    elapsed = elapsed_seconds(status_json, now=now)
    if elapsed is not None:
        tokens["elapsed"] = str(elapsed)

    if events_data is not None:
        name, seq = latest_tool_call(events_data)
        if name is not None and seq is not None:
            tokens["last_tool"] = f"{name}@{seq}"
        tokens["denials"] = str(count_denials(events_data))
        tokens["tool_rate"] = str(
            count_tool_rate(events_data, now=now, run_id=status_json.get("run_id"))
        )

    return tokens


def build_title(status_json, tokens):
    provider = tokens.get("provider") or status_json.get("provider") or ""
    run_id = short_run_id(tokens.get("run_id") or status_json.get("run_id"))
    outcome = tokens.get("outcome")
    last_tool = tokens.get("last_tool", "")
    if last_tool:
        tool_name = last_tool.split("@", 1)[0]
    else:
        tool_name = ""

    if outcome:
        detail = outcome
    elif tool_name:
        detail = tool_name
    else:
        detail = tokens.get("state") or status_json.get("state") or ""

    separator = " · "
    return f"{provider} {run_id}{separator}{detail}"


def report_key(herdr_state, label, tokens, title):
    return (herdr_state, label, title, tuple(sorted(tokens.items())))


def get_hydra_status(run_id):
    try:
        result = subprocess.run(
            [HYDRA, "status", run_id],
            capture_output=True,
            text=True,
            check=True,
        )
        return json.loads(result.stdout)
    except Exception as err:
        print(f"Error reading hydra status for {run_id}: {err}", file=sys.stderr)
        return None


def get_hydra_events(run_id):
    try:
        result = subprocess.run(
            [HYDRA, "show", run_id, "--events"],
            capture_output=True,
            text=True,
            check=True,
        )
        return json.loads(result.stdout)
    except Exception as err:
        print(f"Error reading hydra events for {run_id}: {err}", file=sys.stderr)
        return None


def list_panes():
    try:
        result = subprocess.run(
            ["herdr", "pane", "list"],
            capture_output=True,
            text=True,
            check=True,
        )
        return json.loads(result.stdout).get("result", {}).get("panes", [])
    except Exception as err:
        print(f"Error listing panes: {err}", file=sys.stderr)
        return []


def report_pane(pane_id, herdr_state, label, tokens, title):
    try:
        subprocess.run(
            [
                "herdr",
                "pane",
                "report-agent",
                pane_id,
                "--source",
                "hydra-bridge",
                "--agent",
                "hydra",
                "--state",
                herdr_state,
            ],
            check=True,
            capture_output=True,
        )

        cmd = [
            "herdr",
            "pane",
            "report-metadata",
            pane_id,
            "--source",
            "hydra-bridge",
            "--state-label",
            f"{herdr_state}={label}",
            "--title",
            title,
        ]
        for name, value in sorted(tokens.items()):
            if value:
                cmd.extend(["--token", f"{name}={value}"])
        subprocess.run(cmd, check=True, capture_output=True)
    except Exception as err:
        print(f"Error reporting pane {pane_id}: {err}", file=sys.stderr)


def main():
    last_reported = {}

    while True:
        panes = list_panes()
        for pane in panes:
            pane_tokens = pane.get("tokens", {})
            run_id = pane_tokens.get("run_id")
            if not run_id:
                continue

            pane_id = pane.get("pane_id")
            status_json = get_hydra_status(run_id)
            if not status_json:
                continue

            events_data = None
            if status_json.get("state") == "live":
                events_data = get_hydra_events(run_id)

            herdr_state, label = get_herdr_state_and_label(status_json)
            tokens = build_tokens(status_json, events_data=events_data)
            title = build_title(status_json, tokens)
            key = report_key(herdr_state, label, tokens, title)

            if last_reported.get(pane_id) != key:
                report_pane(pane_id, herdr_state, label, tokens, title)
                last_reported[pane_id] = key

        time.sleep(2)


if __name__ == "__main__":
    main()
