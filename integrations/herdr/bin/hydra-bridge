#!/usr/bin/env python3
import json
import subprocess
import time
import sys
import os

HYDRA = os.environ.get("HYDRA_BIN", "hydra")

# Ticket 49 decisions: timed_out and abandoned map to unknown.
MAPPING = {
    # state: live
    "live": ("working", "live"),
    
    # state: abandoned
    "abandoned": ("unknown", "abandoned"),
    
    # state: ended, mapped by outcome
    "completed": ("idle", "completed"),
    "failed": ("idle", "failed"),
    
    "gated": ("blocked", "gated"),
    "auth_failed": ("blocked", "auth_failed"),
    "rate_limited": ("blocked", "rate_limited"),
    "mcp_unavailable": ("blocked", "mcp_unavailable"),
    "skill_collision": ("blocked", "skill_collision"),
    
    "timed_out": ("unknown", "timed_out"),  # Ticket 49
    "crashed": ("unknown", "crashed"),
}

def get_herdr_state_and_label(hydra_status_json):
    state = hydra_status_json.get("state")
    if state == "live":
        return MAPPING["live"]
    elif state == "abandoned":
        return MAPPING["abandoned"]
    elif state == "ended":
        outcome = hydra_status_json.get("result", {}).get("outcome")
        if outcome in MAPPING:
            return MAPPING[outcome]
        return ("unknown", outcome or "unknown")
    return ("unknown", "unknown")

def get_hydra_status(run_id):
    try:
        result = subprocess.run([HYDRA, "status", run_id], capture_output=True, text=True, check=True)
        return json.loads(result.stdout)
    except Exception as e:
        print(f"Error reading hydra status for {run_id}: {e}", file=sys.stderr)
        return None

def list_panes():
    try:
        result = subprocess.run(["herdr", "pane", "list"], capture_output=True, text=True, check=True)
        return json.loads(result.stdout).get("result", {}).get("panes", [])
    except Exception as e:
        print(f"Error listing panes: {e}", file=sys.stderr)
        return []

def report_state(pane_id, herdr_state, label):
    try:
        subprocess.run([
            "herdr", "pane", "report-agent", pane_id,
            "--source", "hydra-bridge",
            "--agent", "hydra",
            "--state", herdr_state
        ], check=True, capture_output=True)
        
        subprocess.run([
            "herdr", "pane", "report-metadata", pane_id,
            "--source", "hydra-bridge",
            "--state-label", f"{herdr_state}={label}"
        ], check=True, capture_output=True)
    except Exception as e:
        print(f"Error reporting state for {pane_id}: {e}", file=sys.stderr)

def main():
    last_reported = {}
    
    while True:
        panes = list_panes()
        for pane in panes:
            tokens = pane.get("tokens", {})
            run_id = tokens.get("run_id")
            if not run_id:
                continue
            
            pane_id = pane.get("pane_id")
            status_json = get_hydra_status(run_id)
            if not status_json:
                continue
                
            herdr_state, label = get_herdr_state_and_label(status_json)
            
            if last_reported.get(pane_id) != (herdr_state, label):
                report_state(pane_id, herdr_state, label)
                last_reported[pane_id] = (herdr_state, label)
                
        time.sleep(2)

if __name__ == "__main__":
    main()
