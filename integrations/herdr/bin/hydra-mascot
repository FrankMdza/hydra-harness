#!/usr/bin/env python3
"""hydra-mascot: a half-block, truecolor hydra for a Herdr pane, drawn from a reference image.

Prototype from map ticket 75. Python and macOS `sips` only, no PIL. The image is cropped, shrunk
to one pixel per column and two per row, and printed as `▀` cells with the top pixel as the
foreground colour and the bottom as the background, so the terminal shows the picture at roughly
its own aspect. Dark pixels are left transparent so the dragon sits on the pane's background.
`--demo` cycles the poses: idle, working, one head asleep, refused, the meme head, fire.

    hydra-mascot --image ref.jpeg --width 96                 # print once
    hydra-mascot --image ref.jpeg --width 96 --demo 30       # animate for 30 s
    hydra-mascot --image ref.jpeg --width 60 --save ~/.cache/hydra-mascot.ans
    hydra-mascot --load ~/.cache/hydra-mascot.ans            # from .zshrc, like pokemon-colorscripts
    hydra-mascot --small --demo 20                           # the pixel-art sprite, 48 x 15
    hydra-mascot --demo 20                                   # the HydraPet dragon, the default since 2026-09-24
    hydra-mascot --save ~/.cache/hydra-mascot.ans            # its frame for the shell prompt

The image render reads as a dragon at 60 columns and up; below that it is a blob, so the small
sprite is pixel art on a 48 x 28 grid with a nine-colour palette, in the style of the pokemon
sprites that print at shell start. It bobs one pixel, blinks, and each head can sleep or derp.
"""
import argparse, os, random, struct, subprocess, sys, tempfile, time

BONE = (232, 226, 210)
FIRE = [(255, 246, 180), (255, 200, 80), (255, 140, 30), (220, 60, 30), (150, 20, 40)]
SHADES = "░▒▓█"


PIX = """\
.....KK...K.......KH....HK.......K...KK.........
....KHHK.KHK.....KHH....HHK.....KHK.KHHK........
..KKLLGGKGGK.....KLLKKKKLLK.....KGGKGGLLKK......
.KLLEGGGGGGGK....KLGGGGGGLK....KGGGGGGGELLK.....
KLGGGGGGGGGGK...KGEGGGGGGEGK...KGGGGGGGGGGLK....
KBWBWBWdGGGGK...KGGGGGGGGGGK...KGGGGdWBWBWBK....
.KKKKKKKdGGGK...KGBWBWWBWBGK...KGGGdKKKKKKK.....
........KLGGK....KGKKKKKKGK....KGGLK............
........KLGGK.....KLGGGGLK.....KGGLK............
.........KLGGK....KLGGGGLK....KGGLK.............
..........KLGGK...KLGGGGLK...KGGLK..............
...........KLGGK..KLGGGGLK..KGGLK...............
............KLGGKKKLGGGGLKKKGGLK................
.....KK......KLGGGGGGGGGGGGGGLK......KK.........
....KggK.....KGGGGGGGGGGGGGGGGK.....KggK........
...KgGggK...KGGGGGGBBBBBBGGGGGGK...KggGgK.......
..KgGgggGKKKGGGGGGBBBBBBBBGGGGGGKKKGgggGgK......
.KgGgggGgggGGGGGGGBBBBBBBBGGGGGGGgggGgggGgK.....
KgGgggGgggGgggGGGGBBBBBBBBGGGGgggGgggGgggGgK....
KgggGgggGgggGgggGGGBBBBBBGGGgggGgggGgggGgggK....
.KKgggGgggGgggGgGGGGBBBBGGGGgGgggGgggGgggKK.....
...KKKgggGgggKKKGGGGGGGGGGGGKKKgggGgggKKK.......
......KKKKKK..KGGGGKKKKKKGGGGK..KKKKKK..........
..............KLGGGK....KGGGLK..................
..............KLGGGK....KGGGLK..................
.............KWLGGGK....KGGGLWK.................
............KWWKKKKK....KKKKKWWK................
............KKKK............KKKK................
"""

PAL = {
    "K": (24, 20, 32),      # outline
    "G": (82, 150, 128),    # scales
    "L": (122, 190, 160),   # scale highlight
    "d": (52, 108, 92),     # shade under the jaw
    "g": (44, 96, 84),      # wing membrane
    "B": (214, 226, 176),   # belly
    "E": (232, 48, 40),     # eye
    "W": (246, 246, 236),   # teeth and claws
    "H": (226, 214, 176),   # horns
}
PIX_ROWS = [r for r in PIX.split("\n") if r]
assert all(len(r) == len(PIX_ROWS[0]) for r in PIX_ROWS), "ragged pixel map"
MARGIN = 12  # transparent columns on each side, so the side heads have room to breathe fire
TOP = 6      # transparent pixel rows above, so the centre head's blast has somewhere to go
# (x, y, dx, dy) per jaw in pixel space: the left head breathes left, the right head right, and
# the centre head faces you, so its blast goes straight up from between the horns.
PIX_MOUTHS = [(MARGIN + 0, TOP + 5, -1, 0), (MARGIN + 23, TOP - 1, 0, -1), (MARGIN + 47, TOP + 5, 1, 0)]


def load_sprite(path):
    """A sprite file: the pixel map first, one character per pixel, then a blank line, then
    lines `X r g b` for the palette and `mouth x y dx dy` for each jaw (pixel coordinates,
    direction as a unit step). `.` is transparent. Sets PIX_ROWS, PAL and PIX_MOUTHS."""
    global PIX_ROWS, PAL, PIX_MOUTHS
    text = open(path).read()
    head, _, tail = text.partition("\n\n")
    rows = [r for r in head.split("\n") if r and not r.startswith("#")]
    width = max(len(r) for r in rows)
    PIX_ROWS = [r.ljust(width, ".") for r in rows]
    pal, mouths = {}, []
    for line in tail.split("\n"):
        parts = line.split()
        if not parts or parts[0].startswith("#"):
            continue
        if parts[0] == "mouth":
            x, y, dx, dy = (int(v) for v in parts[1:5])
            mouths.append((MARGIN + x, TOP + y, dx, dy))
        elif len(parts) == 4 and len(parts[0]) == 1:
            pal[parts[0]] = tuple(int(v) for v in parts[1:4])
    if not mouths:
        raise SystemExit(f"{path}: no `mouth x y dx dy` line")
    PAL = pal
    PIX_MOUTHS = mouths


def pix_cells(yoff=0, blink=False, closed_eyes=None):
    """The pixel map as (top, bottom) cell pairs, moved down `yoff` pixels. `blink` closes every
    eye; `closed_eyes` closes the eyes whose x falls in a (start, end) range."""
    h = len(PIX_ROWS) + TOP
    w = len(PIX_ROWS[0]) + 2 * MARGIN
    grid = [["."] * w for _ in range(h + 2)]
    for y, row in enumerate(PIX_ROWS):
        for x, ch in enumerate(row):
            gx = x + MARGIN
            if ch == "E" and (blink or (closed_eyes and closed_eyes[0] <= gx < closed_eyes[1])):
                ch = "K"
            grid[y + TOP + yoff][gx] = ch
    cells = []
    for y in range(0, h + 2, 2):
        cells.append([(PAL.get(grid[y][x]), PAL.get(grid[y + 1][x])) for x in range(w)])
    return cells


def shrink(image, width, rows, crop):
    """Crop with sips, shrink to width x 2*rows, return rows of (r, g, b) tuples top-first."""
    tmp = tempfile.mkdtemp()
    cropped = os.path.join(tmp, "crop.jpeg")
    bmp = os.path.join(tmp, "small.bmp")
    if crop:
        y, x, h, w = crop
        subprocess.run(["sips", "--cropOffset", str(y), str(x), "-c", str(h), str(w), image,
                        "--out", cropped], check=True, capture_output=True)
    else:
        cropped = image
    subprocess.run(["sips", "-s", "format", "bmp", "-z", str(rows * 2), str(width), cropped,
                    "--out", bmp], check=True, capture_output=True)
    b = open(bmp, "rb").read()
    off = struct.unpack_from("<I", b, 10)[0]
    w, h = struct.unpack_from("<ii", b, 18)
    bpp = struct.unpack_from("<H", b, 28)[0]
    assert bpp == 24, f"expected a 24-bit BMP, got {bpp}"
    stride = (w * 3 + 3) & ~3
    top_down = h < 0
    h = abs(h)
    px = []
    for r in range(h):
        row = []
        base = off + r * stride
        for c in range(w):
            bl, g, rd = b[base + c * 3: base + c * 3 + 3]
            row.append((rd, g, bl))
        px.append(row)
    if not top_down:
        px.reverse()
    return px


def to_cells(px, threshold, mask):
    """Pairs of pixel rows become one row of cells: (top_rgb|None, bottom_rgb|None)."""
    h = len(px)
    w = len(px[0])
    lums = sorted((r * 299 + g * 587 + b * 114) // 1000 for row in px for (r, g, b) in row)
    top = max(threshold + 1, lums[len(lums) * 99 // 100])
    cells = []
    for r in range(0, h - 1, 2):
        line = []
        for c in range(w):
            pair = []
            for rr in (r, r + 1):
                rd, g, bl = px[rr][c]
                lum = (rd * 299 + g * 587 + bl * 114) // 1000
                masked = mask and (mask[0] <= c / w < mask[2]) and (mask[1] <= rr / h < mask[3])
                if lum < threshold or masked:
                    pair.append(None)
                else:
                    # Stretch the contrast: the reference is dim glyph texture on near-black.
                    k = 0.35 + 0.65 * min(1.0, (lum - threshold) / (top - threshold))
                    pair.append(tuple(int(ch * k) for ch in BONE))
            line.append((pair[0], pair[1]))
        cells.append(line)
    return cells


def tint(rgb, k):
    return tuple(min(255, int(ch * k)) for ch in rgb)


def draw(cells, out, brightness=1.0, shift=0, red=False, flames=None, dim_cols=None):
    """Emit one frame. `flames` maps (row, col) to (char, rgb) drawn over the sprite, and
    `dim_cols` is a (start, end) column range drawn at a third of the brightness."""
    flames = flames or {}
    lines = []
    for r, line in enumerate(cells):
        parts = [" " * max(shift, 0)]
        for c, (top, bot) in enumerate(line):
            if (r, c) in flames:
                ch, rgb = flames[(r, c)]
                parts.append(f"\x1b[0m\x1b[38;2;{rgb[0]};{rgb[1]};{rgb[2]}m{ch}")
                continue
            if top is None and bot is None:
                parts.append("\x1b[0m ")
                continue
            k = brightness / 3 if dim_cols and dim_cols[0] <= c < dim_cols[1] else brightness
            t = tint(top, k) if top else None
            b = tint(bot, k) if bot else None
            if red:
                t = t and (255, t[1] // 3, t[2] // 3)
                b = b and (255, b[1] // 3, b[2] // 3)
            if t and b:
                parts.append(f"\x1b[38;2;{t[0]};{t[1]};{t[2]}m\x1b[48;2;{b[0]};{b[1]};{b[2]}m▀")
            elif t:
                parts.append(f"\x1b[0m\x1b[38;2;{t[0]};{t[1]};{t[2]}m▀")
            else:
                parts.append(f"\x1b[0m\x1b[38;2;{b[0]};{b[1]};{b[2]}m▄")
        parts.append("\x1b[0m\x1b[K")
        lines.append("".join(parts))
    out.write("\n".join(lines) + "\x1b[0m\n")
    out.flush()


def flame_cells(cells, mouths, length, rng):
    """A tongue of fire per mouth. A mouth is (fx, fy) in fractions, rising to the right, or
    (col, row, dx, dy) in cell space with its own direction."""
    rows = len(cells)
    cols = len(cells[0])
    flames = {}
    for m in mouths:
        if len(m) == 2:
            cx, cy, dx, dy = int(m[0] * cols), int(m[1] * rows), 1, -0.45
        else:
            cx, cy, dx, dy = m
        for d in range(1, length):
            spread = rng.randint(-1, 1) if d > 2 else 0
            if dy == 0:
                r = cy - int(d * 0.35) + spread
                c = cx + d * dx
            elif dx == 0:
                r = cy + d * dy
                c = cx + spread
            else:
                r = cy + int(d * dy) + spread
                c = cx + d * dx
            if not (0 <= r < rows and 0 <= c < cols):
                continue
            t = d / length
            heat = max(0.0, 1.0 - t + rng.uniform(-0.15, 0.15))
            ch = SHADES[min(3, int(heat * 4))]
            rgb = FIRE[min(4, int(t * 5))]
            flames[(r, c)] = (ch, rgb)
            if d > length // 2 and rng.random() < 0.4 and r - 1 >= 0:
                flames[(r - 1, c)] = ("░", FIRE[4])
    return flames


def mouth_cell(cells, m):
    """(col, row) of a mouth given as fractions or as cell coordinates."""
    if len(m) == 2:
        return int(m[0] * len(cells[0])), int(m[1] * len(cells))
    return m[0], m[1]


def head_span(cells, mouths, i):
    """The column range of head i, halfway to its neighbours."""
    cols = len(cells[0])
    xs = sorted(mouth_cell(cells, m)[0] / cols for m in mouths)
    lo = 0 if i == 0 else (xs[i - 1] + xs[i]) / 2
    hi = 1.0 if i == len(xs) - 1 else (xs[i] + xs[i + 1]) / 2
    return int(lo * cols), int(hi * cols)


def sleep_cells(cells, mouth, frame):
    """z's drifting up from a sleeping head."""
    rows, cols = len(cells), len(cells[0])
    cx, cy = mouth_cell(cells, mouth)
    out = {}
    side = 1 if mouth[2] >= 0 else -1  # the z's drift away from the jaw
    for i, ch in enumerate("zZz"):
        r = cy - 2 - ((frame // 4 + i * 2) % 5)
        c = cx + side * (2 + i + (frame // 6 + i) % 2)
        if 0 <= r < rows and 0 <= c < cols:
            out[(r, c)] = (ch, (150, 170, 220))
    # a snot bubble that grows at the nostril and pops
    stage = (frame // 8) % 6
    if stage < 5:
        ch = "∘○◯◯◯"[stage]
        r, c = cy - 1, cx + side
        if 0 <= r < rows and 0 <= c < cols:
            out[(r, c)] = (ch, (170, 210, 230))
    return out


def derp_cells(cells, mouth, frame):
    """The meme head: tongue out, one eye wandering."""
    rows, cols = len(cells), len(cells[0])
    cx, cy = mouth_cell(cells, mouth)
    out = {}
    for d in range(2):
        if cy + 1 < rows and cx + d < cols:
            out[(cy + 1, cx + d)] = ("▄", (240, 110, 150))
    er, ec = cy - 3, cx - 3 + ((frame // 4) % 3) - 1
    if 0 <= er < rows and 0 <= ec < cols:
        out[(er, ec)] = ("◉", (30, 30, 40))
    return out


def demo(cells, mouths, seconds, fps, out, frame_source=None):
    """`frame_source(pose, frame, sleeper_span)` returns the cells for this frame when the sprite
    is a pixel map that can bob and blink; None keeps the image render still."""
    rng = random.Random()
    out.write("\x1b[?25l\x1b[2J")
    phase = [("idle", 3), ("working", 3), ("sleep", 4), ("refused", 1), ("derp", 3), ("fire", 4)]
    sleeper = rng.randrange(len(mouths))
    derp = rng.randrange(len(mouths))
    cycle_len = sum(secs for _, secs in phase)
    last_cycle = 0
    t0 = time.time()
    frame = 0
    try:
        while time.time() - t0 < seconds:
            cycle = int((time.time() - t0) // cycle_len)
            if cycle != last_cycle:
                last_cycle = cycle
                sleeper = rng.randrange(len(mouths))
                derp = rng.choice([i for i in range(len(mouths)) if i != sleeper] or [0])
            elapsed = (time.time() - t0) % cycle_len
            pose, acc = "idle", 0
            for name, secs in phase:
                acc += secs
                if elapsed < acc:
                    pose = name
                    break
            out.write("\x1b[H")
            if frame_source:
                cells = frame_source(pose, frame, head_span(cells, mouths, sleeper))
            if pose == "idle":
                k = 0.85 + 0.15 * abs(((frame // 4) % 4) - 2) / 2
                draw(cells, out, brightness=k)
            elif pose == "working":
                draw(cells, out, shift=(frame // 3) % 2)
            elif pose == "sleep":
                draw(cells, out, flames=sleep_cells(cells, mouths[sleeper], frame))
            elif pose == "derp":
                draw(cells, out, shift=(frame // 5) % 2,
                     flames=derp_cells(cells, mouths[derp], frame))
            elif pose == "refused":
                draw(cells, out, red=(frame % 2 == 0), shift=1 if frame % 2 else 0)
            else:
                length = 8 + int(6 * abs(((frame // 2) % 6) - 3) / 3) + rng.randint(-1, 1)
                draw(cells, out, brightness=1.1, flames=flame_cells(cells, mouths, length, rng))
            out.write(f"\x1b[0m {pose:<8}\x1b[K\n")
            out.flush()
            frame += 1
            time.sleep(1 / fps)
    finally:
        out.write("\x1b[0m\x1b[?25h\n")
        out.flush()


def pet_cells(t, heads, fires, pet=False, scale=2):
    """One frame of the compact HydraPet dragon (24 x 24 pixels, drawn per frame by the vendored
    `hydrapet.render_compact_dragon`) as cells, scaled up by whole pixels."""
    import importlib.util
    here = os.path.dirname(os.path.abspath(__file__))
    spec = importlib.util.spec_from_file_location("hydrapet", os.path.join(here, "..", "mascot", "hydrapet.py"))
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    grid = mod.render_compact_dragon(t, heads, fires, pet_active=pet)
    h, w = grid.shape[:2]
    px = []
    for y in range(h):
        row = []
        for x in range(w):
            r, g, b, a = (int(v) for v in grid[y, x])
            row.append(None if a < 40 else (r * a // 255, g * a // 255, b * a // 255))
        px.append([v for v in row for _ in range(scale)])
    px = [row for row in px for _ in range(scale)]
    cells = []
    for y in range(0, len(px) - 1, 2):
        cells.append([(px[y][x], px[y + 1][x]) for x in range(len(px[0]))])
    return cells


def pet_demo(seconds, fps, out, scale):
    """The pet's own art, driven by the same pose cycle as the sprites: idle, working, one head
    asleep, refused (a red flash), the meme head (hearts, the pet's nearest gesture), fire."""
    rng = random.Random()
    out.write("\x1b[?25l\x1b[2J")
    phase = [("idle", 3), ("working", 3), ("sleep", 4), ("refused", 1), ("derp", 3), ("fire", 4)]
    cycle_len = sum(secs for _, secs in phase)
    sleeper = rng.randrange(3)
    t0 = time.time()
    frame = 0
    last_cycle = 0
    try:
        while time.time() - t0 < seconds:
            now = time.time() - t0
            cycle = int(now // cycle_len)
            if cycle != last_cycle:
                last_cycle = cycle
                sleeper = rng.randrange(3)
            elapsed = now % cycle_len
            pose, acc = "idle", 0
            for name, secs in phase:
                acc += secs
                if elapsed < acc:
                    pose = name
                    break
            heads = ["awake", "awake", "awake"]
            fires = [0.0, 0.0, 0.0]
            pet = False
            if pose == "sleep":
                heads[sleeper] = "sleeping"
            elif pose == "fire":
                heads = ["firing", "firing", "firing"]
                fires = [1.0, 1.0, 1.0]
            elif pose == "derp":
                pet = True
            speed = 2.0 if pose == "working" else 1.0
            cells = pet_cells(now * speed, heads, fires, pet, scale)
            out.write("\x1b[H")
            draw(cells, out, red=(pose == "refused" and frame % 2 == 0))
            out.write(f"\x1b[0m {pose:<8}\x1b[K\n")
            out.flush()
            frame += 1
            time.sleep(1 / fps)
    finally:
        out.write("\x1b[0m\x1b[?25h\n")
        out.flush()


def write_png(cells, path, scale=8):
    """A preview of the sprite as it would look on screen, one pixel as scale x scale dots (a
    terminal cell is about twice as tall as wide and holds two pixels, so pixels are square),
    written as a BMP and converted with sips. For checking a sprite file without a terminal."""
    H = len(cells) * 2
    W = len(cells[0])
    rowbytes = (W * scale * 3 + 3) & ~3
    data = bytearray()
    for y in range(H - 1, -1, -1):
        line = bytearray()
        for x in range(W):
            top, bot = cells[y // 2][x]
            rgb = (top if y % 2 == 0 else bot) or (20, 20, 24)
            line += bytes([rgb[2], rgb[1], rgb[0]]) * scale
        line += b"\0" * (rowbytes - len(line))
        for _ in range(scale):
            data += line
    hs, ws = H * scale, W * scale
    hdr = b"BM" + struct.pack("<IHHI", 54 + len(data), 0, 0, 54) + struct.pack(
        "<IiiHHIIiiII", 40, ws, hs, 1, 24, 0, len(data), 2835, 2835, 0, 0)
    bmp = path + ".bmp"
    open(bmp, "wb").write(hdr + data)
    subprocess.run(["sips", "-s", "format", "png", bmp, "--out", path], check=True, capture_output=True)
    os.remove(bmp)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--image", help="the reference image; required unless --load or --small")
    ap.add_argument("--sprite", help="a sprite file (map, palette, mouths); implies --small")
    ap.add_argument("--png", help="with --small or --sprite: write a scaled PNG preview and exit")
    ap.add_argument("--pet", action="store_true",
                    help="the HydraPet compact dragon (mascot/hydrapet.py), drawn per frame; needs numpy")
    ap.add_argument("--scale", type=int, default=2, help="with --pet: whole-pixel upscale, 2 gives 48 columns")
    ap.add_argument("--small", action="store_true",
                    help="the pixel-art sprite, 48 columns of dragon plus margins for the fire, 15 rows")
    ap.add_argument("--width", type=int, default=70)
    ap.add_argument("--crop", default="40,80,1480,2660",
                    help="y,x,h,w in source pixels; the default fits the 2816x1536 reference")
    ap.add_argument("--mask", default="0,0,0.29,0.11",
                    help="fx0,fy0,fx1,fy1 of the crop to blank, the reference's title box")
    ap.add_argument("--mouths", default="0.34,0.47;0.60,0.30;0.80,0.44",
                    help="fx,fy per jaw, semicolon separated")
    ap.add_argument("--threshold", type=int, default=36, help="luminance under this is transparent")
    ap.add_argument("--save", help="write the rendered frame as ANSI text to this file and exit")
    ap.add_argument("--load", help="print a frame saved with --save; no image or sips needed")
    ap.add_argument("--demo", type=float, default=0, help="animate for this many seconds")
    ap.add_argument("--fps", type=float, default=8)
    a = ap.parse_args()
    if a.load:
        sys.stdout.write(open(a.load).read())
        return
    if not (a.pet or a.small or a.sprite or a.image or a.load):
        a.pet = True  # the human's pick on 2026-09-24: the HydraPet dragon is the mascot
    if a.pet:
        if a.demo:
            pet_demo(a.demo, a.fps, sys.stdout, a.scale)
            return
        cells = pet_cells(0.3, ["awake", "awake", "awake"], [0.0, 0.0, 0.0], False, a.scale)
        if a.png:
            write_png(cells, a.png)
        elif a.save:
            with open(a.save, "w") as f:
                draw(cells, f)
        else:
            draw(cells, sys.stdout)
        return
    if a.small and not a.sprite:
        # The default small sprite is the best of the sprite files beside this script: codex's,
        # chosen by the human on 2026-09-24 over agy's and the session's.
        default = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "sprites", "hydra-codex.txt")
        if os.path.exists(default):
            a.sprite = default
    if a.sprite:
        load_sprite(a.sprite)
        a.small = True
    if a.small and a.png:
        write_png(pix_cells(), a.png)
        return
    if a.small:
        mouths = [(x, y // 2, dx, dy) for (x, y, dx, dy) in PIX_MOUTHS]

        def source(pose, frame, sleeper_span):
            bob = (frame // 6) % 2 if pose in ("idle", "working", "derp") else 0
            blink = pose == "idle" and frame % 40 in (0, 1)
            closed = sleeper_span if pose == "sleep" else None
            return pix_cells(yoff=bob, blink=blink, closed_eyes=closed)

        if a.demo:
            demo(pix_cells(), mouths, a.demo, a.fps, sys.stdout, frame_source=source)
        elif a.save:
            with open(a.save, "w") as f:
                draw(pix_cells(), f)
        else:
            draw(pix_cells(), sys.stdout)
        return
    if not a.image:
        ap.error("--image is required unless --load or --small is given")
    crop = [int(v) for v in a.crop.split(",")] if a.crop else None
    mask = [float(v) for v in a.mask.split(",")] if a.mask else None
    mouths = [tuple(float(v) for v in m.split(",")) for m in a.mouths.split(";")]
    aspect = (crop[2] / crop[3]) if crop else 0.55
    rows = max(6, round(a.width * aspect / 2))
    px = shrink(a.image, a.width, rows, crop)
    cells = to_cells(px, a.threshold, mask)
    if a.save:
        with open(a.save, "w") as f:
            draw(cells, f)
    elif a.demo:
        demo(cells, mouths, a.demo, a.fps, sys.stdout)
    else:
        draw(cells, sys.stdout)


if __name__ == "__main__":
    main()
