<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  A template. Replace /Users/USER with your home before installing; integrations/grader/README.md
  has the commands. Runs one collect every 15 minutes, which also scores each new run with every
  model under $HYDRA_GRADER_HOME/models/.

  The program is the release build of crates/grader, so build the workspace in release mode
  first; the README has the command. HYDRA_BIN is an absolute path because the grader runs the
  hydra-puppets beside it and never searches PATH for either. HYDRA_PUPPETS_DATA names the
  directory aliases.json is read from, so the job does not depend on where the binary sits.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>co.hephaestuslab.hydra-grader</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/USER/hydra/target/release/hydra-grader</string>
    <string>once</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HYDRA_ROOT</key>
    <string>/Users/USER/hydra</string>
    <key>HYDRA_GRADER_HOME</key>
    <string>/Users/USER/hydra/grader</string>
    <key>HYDRA_BIN</key>
    <string>/Users/USER/hydra/target/release/hydra</string>
    <key>HYDRA_PUPPETS_DATA</key>
    <string>/Users/USER/hydra/integrations/puppets</string>
    <key>PATH</key>
    <string>/Users/USER/.local/bin:/Users/USER/.cargo/bin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
  </dict>
  <key>StartInterval</key>
  <integer>900</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/USER/hydra/grader/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/USER/hydra/grader/launchd.log</string>
</dict>
</plist>
