#!/usr/bin/env bash
set -euo pipefail

# Build ticket 249. Claude Code reads the CLAUDE.md of its working directory
# and of every directory above it, so a chat started anywhere under this
# repository would still load the repository's build instructions. The chat
# starts in a directory outside the repository instead, holding only the
# copilot's document, rendered with the repository's absolute path.
REPO="$(cd "$(dirname "$0")/../../.." && pwd)"
HOME_DIR="${HYDRA_COPILOT_HOME:-$HOME/.hydra-copilot}"
case "$HOME_DIR/" in
  "$REPO"/*) echo "hydra-copilot: $HOME_DIR is inside $REPO; pick a directory outside it" >&2; exit 1 ;;
esac
mkdir -p "$HOME_DIR"
sed "s|{{REPO}}|$REPO|g" "$REPO/integrations/copilot/CLAUDE.md" > "$HOME_DIR/CLAUDE.md"
cd "$HOME_DIR"

HYDRA="${HYDRA_BIN:-hydra}"
MODEL="${1:-sonnet}"

exec "$HYDRA" cockpit --session claude --model "$MODEL"
