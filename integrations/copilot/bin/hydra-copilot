#!/usr/bin/env bash
set -euo pipefail

# Build ticket 249, 253, 258. Claude Code reads the CLAUDE.md of its working directory
# and of every directory above it, so a chat started anywhere under this
# repository would still load the repository's build instructions. The chat
# starts in a directory outside the repository instead, holding only the
# copilot's document, rendered with the repository's absolute path.
DEFAULT_REPO="$(cd "$(dirname "$0")/../../.." && pwd)"
# `copilot` by default; `puppets` adds the Master of Puppets loop and its own start directory.
MODE="${HYDRA_COPILOT_MODE:-copilot}"
case "$MODE" in
  copilot) HOME_DIR="${HYDRA_COPILOT_HOME:-$HOME/.hydra-copilot}" ;;
  puppets) HOME_DIR="${HYDRA_COPILOT_HOME:-$HOME/.hydra-puppets-copilot}" ;;
  *) echo "hydra-copilot: HYDRA_COPILOT_MODE must be copilot or puppets" >&2; exit 1 ;;
esac
MODEL="${1:-}"
PROVIDER="${3:-claude}"

if [[ $# -ge 2 ]]; then
  if ! REPO="$(git -C "$2" rev-parse --show-toplevel 2>/dev/null)"; then
    echo "hydra-copilot: $2 is not a git repository" >&2
    exit 1
  fi
else
  REPO="$DEFAULT_REPO"
fi

case "$PROVIDER" in
  claude|codex) ;;
  *)
    echo "hydra-copilot: provider must be claude or codex" >&2
    exit 1
    ;;
esac

case "$HOME_DIR/" in
  "$REPO"/*) echo "hydra-copilot: $HOME_DIR is inside $REPO; pick a directory outside it" >&2; exit 1 ;;
esac
mkdir -p "$HOME_DIR"

# One source:destination pair per rendered file; map 100 D3 adds GEMINI.md later.
while IFS=: read -r src dst; do
  sed -e "s|{{REPO}}|$REPO|g" -e "s|{{HYDRA}}|$DEFAULT_REPO|g" "$DEFAULT_REPO/integrations/copilot/$src" > "$HOME_DIR/$dst"
done <<'PAIRS'
COPILOT.md:CLAUDE.md
COPILOT.md:AGENTS.md
PAIRS

# Master of Puppets: the mode's document and the skill's text go after the copilot's in both
# files, and on `claude` the skill is also a project skill here, so `/puppets` exists.
if [[ "$MODE" == puppets ]]; then
  SKILL="$DEFAULT_REPO/.claude/skills/puppets/SKILL.md"
  render() { sed -e "s|{{REPO}}|$REPO|g" -e "s|{{HYDRA}}|$DEFAULT_REPO|g" -e "s|~/hydra/|$DEFAULT_REPO/|g" "$1"; }
  for dst in CLAUDE.md AGENTS.md; do
    { render "$DEFAULT_REPO/integrations/copilot/PUPPETS.md"; echo; awk 'n >= 2 { print } /^---$/ { n++ }' "$SKILL" | render /dev/stdin; } >> "$HOME_DIR/$dst"
  done
  mkdir -p "$HOME_DIR/.claude/skills/puppets"
  render "$SKILL" > "$HOME_DIR/.claude/skills/puppets/SKILL.md"
fi

cd "$HOME_DIR"

HYDRA="${HYDRA_BIN:-hydra}"

# Sonnet is a `claude` model; `codex` keeps its own default when none is named.
if [[ -z "$MODEL" && "$PROVIDER" == claude ]]; then
  MODEL=sonnet
fi
if [[ -n "$MODEL" ]]; then
  exec "$HYDRA" cockpit --session "$PROVIDER" --model "$MODEL"
fi
exec "$HYDRA" cockpit --session "$PROVIDER"
