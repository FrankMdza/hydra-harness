target/
# What Hydra writes under ~/hydra, which on this machine is this checkout. Every
# one is anchored to the repo root: unanchored, `skills/` matched `src/skills/`
# at any depth and hid the source directory from git.
/runs/
/worktrees/
/spawn/
/skills/
/skills-snapshots/
/skill-worktrees/
/pruned/
/reservations/
# Where the Claude Code harness puts a subagent's isolated checkout of this repo.
/.claude/worktrees/
.DS_Store
# Frank's own status page, kept on this machine and out of the repository.
# Ignored so `seed_tree` (git add -A) stops carrying it into every run's worktree.
/docs/status.html
/puppets/
/grader/

# Secrets the author keeps beside the checkout. Ignored, so the worktree seed never copies them into a run.
.env
.env.*

# The project's own Python, made with `uv venv --python 3.12 .venv`. Ignored so the worktree seed never copies it.
/.venv/

# Task shards for labelling runs: redacted task text, data and not source.
/.scratch/hydra/labeling/*/tasks-*.jsonl
__pycache__/
*.pyc
approvals/
# Build ticket 292: the model table `hydra models refresh` writes under the data root.
/models.json
/models.json.tmp

# Map 130, 2026-10-15: the author's own pending list and two labeling shards of a session's
# work, untracked on this machine and one `git add -A` away from the public repository.
/pendintes_hydra.md
/.scratch/hydra/labeling/*/shard-*.jsonl
/.scratch/hydra/labeling/*/classes-*.jsonl
